{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RTX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-msvc-ninja",
      "displayName": "Windows MSVC (Ninja, VS 2022/2026)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "zig-windows",
      "displayName": "Windows (native compiler; Zig 0.13 fallback)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchain-zig.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "zig-linux",
      "displayName": "Linux (native compiler; Zig 0.13 fallback)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchain-zig.cmake",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux native release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC release",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "RTX_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "zig-windows",
      "configurePreset": "zig-windows"
    },
    {
      "name": "zig-linux",
      "configurePreset": "zig-linux"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-msvc-ninja",
      "configurePreset": "windows-msvc-ninja"
    }
  ],
  "testPresets": [
    {
      "name": "zig-windows",
      "configurePreset": "zig-windows",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "zig-linux",
      "configurePreset": "zig-linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-ninja",
      "configurePreset": "windows-msvc-ninja",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
