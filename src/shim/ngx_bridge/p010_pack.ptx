	// .globl	rtx_yuv_to_rgb10_buf
	// Phase 11.2 (C-02): raw-pointer variant of rtx_yuv_to_rgb10 for the
	// D3D12 shared preview-buffer ring.  Same YUV->RGB10 math, same register
	// schedule; the single surface store (sust.b.2d.b32) becomes a linear
	// st.global.b32 at out_ptr + y * out_pitch_bytes + x * 4, which is what a
	// D3D12_RESOURCE_DIMENSION_BUFFER mapped through cuExternalMemoryGetMapped-
	// Buffer is from the CUDA side.  Parameter 10 is the output row pitch in
	// bytes; all other parameters keep the rtx_yuv_to_rgb10 semantics.
